POSTGRES_DB=trading
POSTGRES_USER=bot
POSTGRES_PASSWORD=CHANGE_MOI_mot_de_passe_fort

# Générer avec: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_MOI_secret_jwt_fort

BACKEND_IMAGE=ghcr.io/OWNER/trading-backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/trading-frontend:latest

